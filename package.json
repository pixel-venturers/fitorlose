{
  "name": "fitorlose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run contract:emit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "contract:emit": "npx --yes prisma@next contract emit --config prisma.config.js",
    "db:update": "npx --yes prisma@next db update --config prisma.config.js",
    "db:verify": "npx --yes prisma@next db verify --config prisma.config.js",
    "db:seed": "node --env-file=.env.local prisma/seed.js",
    "migrate:plan": "npx --yes prisma@next migration plan --config prisma.config.js",
    "migrate": "npx --yes prisma@next migrate --config prisma.config.js",
    "format": "prettier --write \"**/*.{js,jsx,mdx}\" --cache"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.0",
    "@clerk/ui": "^1.30.6",
    "@prisma/orm-postgres": "8.0.0-rc.4",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "dodopayments": "^2.47.0",
    "dodopayments-checkout": "^1.9.8",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "posthog-js": "^1.418.10",
    "posthog-node": "^5.50.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@prisma/cli-engine": "0.2.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4"
  },
  "overrides": {
    "effect": "4.0.0-beta.103"
  }
}
