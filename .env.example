# =============================================================================
# FitOrLose — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# secrets — `.env.local` is gitignored. Each entry documents: what it is, how to
# obtain it, and what the value looks like.
#
# Legend:  [REQUIRED] app won't work without it · [OPTIONAL] feature degrades
#          gracefully if unset · NEXT_PUBLIC_* is exposed to the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# [REQUIRED] Public base URL of the app. No trailing slash. Used to build the
# payment return URL and the fitness OAuth redirect URLs, so it MUST match the
# origin the browser actually uses.
#   Local dev:   http://localhost:3000
#   Production:  https://fitorlose.lol   (your real deployed domain)
# NOTE: also update SITE.url in config/site.js to your domain (used for SEO /
# sitemap / canonical / Open Graph).
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# Database — Neon (PostgreSQL)
# -----------------------------------------------------------------------------
# [REQUIRED] Postgres connection string.
#   Get it: https://console.neon.tech → your project → "Connection Details" →
#   copy the "Pooled connection" string (host contains `-pooler`). Keep
#   `sslmode=require`.
#   Format: postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=


# -----------------------------------------------------------------------------
# Authentication — Clerk
# -----------------------------------------------------------------------------
# [REQUIRED] From https://dashboard.clerk.com → your app → "API Keys".
#   Publishable key is safe for the browser; Secret key is server-only.
#   Format: pk_test_xxx / sk_test_xxx  (use pk_live_/sk_live_ in production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# [OPTIONAL] Clerk route hints (defaults already match this app's routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"


# -----------------------------------------------------------------------------
# Admin access
# -----------------------------------------------------------------------------
# [REQUIRED] Comma-separated emails that become ADMIN on sign-in (they get the
# /admin panel). Match the email on the user's Clerk account. Also the list of
# recipients for admin alert emails (see Email section).
ADMIN_EMAILS="you@example.com,teammate@example.com"


# -----------------------------------------------------------------------------
# Payments — Dodo Payments (international, and INR via adaptive currency)
# See DODO_SETUP.md for the full walkthrough.
# -----------------------------------------------------------------------------
# [REQUIRED for payments] Server API key. https://app.dodopayments.com →
#   Developer → API Keys. Use a test-mode key while developing.
#   Format: dodo_test_xxx  (dodo_live_xxx in production)
DODO_PAYMENTS_API_KEY="dodo_test_xxx"
# [REQUIRED for payments] "test_mode" (default) or "live_mode".
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# [REQUIRED for payments] Webhook signing secret. Developer → Webhooks → your
#   endpoint → "Signing secret". Used to verify inbound webhooks.
#   Format: whsec_xxx
DODO_PAYMENTS_WEBHOOK_KEY="whsec_xxx"
# [REQUIRED for payments] Pay-What-You-Want product ids — ONE per currency. The
#   PWYW amount is charged in each product's BASE currency, so the INR product
#   must have an ₹ base and the USD product a $ base. Create them under
#   Products → New (Pay what you want). Copy each product id.
#   Format: pdt_xxx
DODO_PRODUCT_ID_INR="pdt_inr_xxx"
DODO_PRODUCT_ID_USD="pdt_usd_xxx"
# DODO_PRODUCT_ID="pdt_xxx"
# [REQUIRED for payments] Overlay checkout SDK mode on the client: "test" or
#   "live". MUST match DODO_PAYMENTS_ENVIRONMENT.
NEXT_PUBLIC_DODO_MODE="test"


# -----------------------------------------------------------------------------
# Analytics — PostHog (product analytics + public visitor stats)
# -----------------------------------------------------------------------------
# [REQUIRED for analytics] Client project token. https://app.posthog.com →
#   Settings → Project → "Project API Key". Safe for the browser. Powers
#   client-side capture, pageviews and session data.
#   Format: phc_xxx
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_xxx"
# [REQUIRED for analytics] Ingestion host for your region.
#   US cloud: https://us.i.posthog.com   ·   EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# [OPTIONAL] Server-side visitor stats for the landing/stats pages via the
#   PostHog Query API. If unset, visitor numbers show "—" and nothing breaks.
#   POSTHOG_PROJECT_ID: the number in your project URL app.posthog.com/project/<ID>.
POSTHOG_PROJECT_ID="12345"
#   POSTHOG_PERSONAL_API_KEY: Settings → "Personal API keys" → Create. Needs the
#   "Query Read" scope. Server-only — never expose it.
#   Format: phx_xxx
POSTHOG_PERSONAL_API_KEY="phx_xxx"
#   App host for the Query API (NOT the ingestion host above).
#   US: https://us.posthog.com   ·   EU: https://eu.posthog.com
POSTHOG_API_HOST="https://us.posthog.com"


# -----------------------------------------------------------------------------
# Email — Gmail SMTP (transactional + admin alerts)
# -----------------------------------------------------------------------------
# All mail sends via Gmail SMTP (smtp.gmail.com:587, TLS) using a Gmail
# **App Password** (Google Account → Security → 2-Step Verification → App
# passwords), NOT your normal password. Admin alerts go to ADMIN_EMAILS (above);
# CTA links use NEXT_PUBLIC_APP_URL, so set that too.
#
# CONTACT_EMAIL is the visible "From". If it's a Gmail "Send mail as" alias on a
# custom domain, it CANNOT be the SMTP login — set GMAIL_USER to the real
# @gmail.com account that owns the App Password and has the alias verified. If
# CONTACT_EMAIL is itself the Gmail login, leave GMAIL_USER unset. The App
# Password always belongs to GMAIL_USER (or CONTACT_EMAIL when GMAIL_USER unset).
CONTACT_EMAIL="contact@yourdomain.com"
GMAIL_USER="you@gmail.com"
CONTACT_PASSWORD="gmail_app_password"


# -----------------------------------------------------------------------------
# Fitness integrations (Strava + Fitbit). See FITNESS_SETUP.md.
# -----------------------------------------------------------------------------
# [REQUIRED to connect any provider] Encrypts stored provider access/refresh
#   tokens at rest (AES-256-GCM) and signs OAuth state. Keep it secret and
#   STABLE — changing it invalidates every stored token (users must reconnect).
#   Generate:  openssl rand -base64 48
FITNESS_TOKEN_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# --- Strava (fully wired; works on http://localhost) ---
# [OPTIONAL] Strava API application. https://www.strava.com/settings/api →
#   create an app. Authorization Callback Domain = `localhost` (dev) or your
#   domain (prod). Copy Client ID / Client Secret.
STRAVA_CLIENT_ID="12345"
STRAVA_CLIENT_SECRET="your_strava_client_secret"
# [OPTIONAL] A random string YOU choose; verifies the Strava webhook handshake
#   (only needed if you register a Strava push subscription).
STRAVA_WEBHOOK_VERIFY_TOKEN="pick-a-random-verify-token"

# --- Fitbit (fully wired; requires an HTTPS callback → use a tunnel in dev) ---
# [OPTIONAL] Fitbit API application. https://dev.fitbit.com/apps/new →
#   OAuth 2.0 Application Type = "Server"; Callback URL =
#   https://<your-host>/api/fitness/fitbit/callback . Copy Client ID / Secret.
FITBIT_CLIENT_ID="23XXXX"
FITBIT_CLIENT_SECRET="your_fitbit_client_secret"


# -----------------------------------------------------------------------------
# File uploads — Cloudinary (cover images + proof files)
# -----------------------------------------------------------------------------
# [OPTIONAL] Cloudinary credentials. https://cloudinary.com → Dashboard →
#   "Product Environment Credentials" (Cloud name, API Key, API Secret).
#   Without these, uploads fail gracefully (cover falls back to a gradient;
#   proof needs a file to submit). The API secret is server-only — never expose.
#   Formats: cloud name = "your-cloud"; API key = "123456789012345";
#            API secret = long alphanumeric string.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"